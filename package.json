{
  "name": "@o.z/vite-plugin-swc",
  "version": "0.8.0",
  "description": "A high-performance Vite plugin that transforms TypeScript and JavaScript files using SWC for lightning-fast builds",
  "homepage": "https://github.com/z-npm/vite-plugin-swc#readme",
  "docs": "https://github.com/z-npm/vite-plugin-swc#readme",
  "bugs": {
    "url": "https://github.com/z-npm/vite-plugin-swc/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/z-npm/vite-plugin-swc.git"
  },
  "author": {
    "name": "Zero Red",
    "email": "github@zero-red.dev",
    "url": "https://github.com/zero-red-dev"
  },
  "maintainers": [
    {
      "name": "Zero Red",
      "email": "github@zero-red.dev",
      "url": "https://github.com/zero-red-dev"
    }
  ],
  "contributors": [
    {
      "name": "Timothée Pillard",
      "url": "https://github.com/ziir"
    }
  ],
  "license": "MIT",
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/zero-red-dev"
  },
  "social": {
    "tiktok": "@zero.red.dev",
    "github": "zero-red-dev"
  },
  "keywords": [
    "vite",
    "vite-plugin",
    "swc",
    "typescript",
    "javascript",
    "transformer",
    "compiler",
    "build",
    "rollup",
    "rollup-plugin",
    "decorators",
    "top-level-await",
    "fast",
    "performance"
  ],
  "type": "module",
  "files": [
    "dist"
  ],
  "peerDependencies": {
    "rollup": ">3",
    "vite": ">5"
  },
  "peerDependenciesMeta": {
    "rollup": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "sideEffects": false,
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && yarn docs",
    "local": "yarn build && yarn unlink && yarn link",
    "docs": "typedoc",
    "docs:watch": "typedoc --watch",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/jsdom": "^28.0.1",
    "@types/node": "^25.5.2",
    "@vitest/coverage-v8": "^4.1.2",
    "@vitest/ui": "^4.1.2",
    "glob": "^13.0.6",
    "jsdom": "^29.0.1",
    "rollup-plugin-node-externals": "^8.1.2",
    "sass": "^1.99.0",
    "typedoc": "^0.28.18",
    "typedoc-plugin-markdown": "^4.11.0",
    "typescript": "^6.0.2",
    "vite": "^8.0.3",
    "vite-plugin-dts": "^4.5.4",
    "vite-plugin-lib-inject-css": "^2.2.2",
    "vitest": "^4.1.2"
  },
  "dependencies": {
    "@rollup/pluginutils": "^5.3.0",
    "@swc/core": "^1.15.24"
  },
  "packageManager": "yarn@4.13.0",
  "types": "./dist/index.d.ts",
  "module": "./dist/index.js",
  "main": "./dist/index.cjs",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  }
}
