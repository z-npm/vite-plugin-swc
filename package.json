{
  "name": "@z-code/vite-plugin-swc",
  "version": "0.5.4",
  "description": "A high-performance Vite plugin that transforms TypeScript and JavaScript files using SWC for lightning-fast builds",
  "homepage": "https://github.com/z-npm/vite-plugin-swc#readme",
  "bugs": {
    "url": "https://github.com/z-npm/vite-plugin-swc/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/z-npm/vite-plugin-swc.git"
  },
  "author": {
    "name": "Zero Red",
    "email": "github@zero-red.dev",
    "url": "https://github.com/zero-red-dev"
  },
  "contributors": [
    {
      "name": "Timothée Pillard",
      "url": "https://github.com/ziir"
    }
  ],
  "license": "MIT",
  "keywords": [
    "vite",
    "vite-plugin",
    "swc",
    "typescript",
    "javascript",
    "transformer",
    "compiler",
    "build",
    "rollup",
    "rollup-plugin",
    "decorators",
    "top-level-await",
    "fast",
    "performance"
  ],
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "dist/index.umd.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.umd.cjs"
    }
  },
  "scripts": {
    "build": "tsc && vite build",
    "local": "yarn build && yarn unlink && yarn link"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "rollup-plugin-node-externals": "^8.1.2",
    "typescript": "^5.9.3",
    "vite": "^7.2.6",
    "vite-plugin-dts": "^4.5.4"
  },
  "peerDependencies": {
    "rollup": ">3",
    "vite": ">4"
  },
  "peerDependenciesMeta": {
    "rollup": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  },
  "dependencies": {
    "@rollup/pluginutils": "^5.3.0",
    "@swc/core": "^1.15.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "sideEffects": false,
  "packageManager": "yarn@4.12.0"
}
